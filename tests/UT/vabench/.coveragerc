[run]
branch = True
parallel = True
source = ais_bench
data_file = test_reports/vabench/.coverage

[report]
include =
    */ais_bench/benchmark/utils/vabench/*.py
    */ais_bench/benchmark/tasks/vabench/*.py
    */ais_bench/benchmark/summarizers/vabench_*.py
    */ais_bench/tools/vabench/*.py
    */ais_bench/benchmark/datasets/vabench.py
    */ais_bench/benchmark/tasks/vabench_eval.py
    */ais_bench/benchmark/summarizers/vabench.py
show_missing = True
precision = 2
fail_under = 80

[html]
directory = test_reports/vabench/htmlcov

[json]
output = test_reports/vabench/coverage.json

[xml]
output = test_reports/vabench/coverage.xml
