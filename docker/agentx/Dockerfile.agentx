ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG AGENTX_PYTHON=python3.12

# 部分依赖（如 crick）没有预编译 wheel，需要本地编译；除编译器外还必须保证 Python
# 头文件（Python.h）与 binutils：
# - Ubuntu 运行镜像没有 gcc；直接装发行版原生 gcc 包即可，它会同时提供带三元组前缀
#   的 gcc（amd64: x86_64-linux-gnu-gcc，arm64: aarch64-linux-gnu-gcc）。
#   注意不能写 gcc-x86_64-linux-gnu：Ubuntu 的交叉包名是 gcc-x86-64-linux-gnu，
#   而原生 gcc 已经满足本地编译需求。头文件由 ${AGENTX_PYTHON}-dev 提供。
# - openEuler 基础镜像自带 gcc，但只装了 python3，没有 python3-devel，编译 C 扩展时
#   会因缺 Python.h 失败；因此不能只在 gcc 缺失时才进 dnf 分支。
RUN set -eu; \
    if command -v apt-get > /dev/null 2>&1; then \
        apt-get update; \
        apt-get install -y --no-install-recommends gcc binutils "${AGENTX_PYTHON}-dev"; \
        rm -rf /var/lib/apt/lists/*; \
    elif command -v dnf > /dev/null 2>&1; then \
        dnf install -y gcc binutils; \
        dnf install -y "${AGENTX_PYTHON}-devel" || dnf install -y python3-devel; \
        dnf clean all; \
    else \
        echo "未找到可用的包管理器，无法安装编译依赖" >&2; exit 1; \
    fi; \
    "${AGENTX_PYTHON}" -c "import sysconfig, os; p = os.path.join(sysconfig.get_paths()['include'], 'Python.h'); assert os.path.exists(p), f'Python.h not found: {p}'"

RUN case "${AGENTX_PYTHON}" in \
        python3.11|python3.12) ;; \
        *) echo "AGENTX_PYTHON must be python3.11 or python3.12" >&2; exit 1 ;; \
    esac && \
    ${AGENTX_PYTHON} -m venv /opt/venvs/agentx113 && \
    CC=gcc /opt/venvs/agentx113/bin/python -m pip install --no-cache-dir \
        -r /benchmark/requirements/agentx.txt \
        -i https://repo.huaweicloud.com/repository/pypi/simple \
        --trusted-host repo.huaweicloud.com \
        --use-pep517 && \
    /opt/venvs/agentx113/bin/python -m pip check && \
    /opt/venvs/agentx113/bin/python -c "import importlib.metadata as m,sys; assert sys.version_info[:2] in ((3,11),(3,12),(3,13)); assert m.version('agentx-harness')=='1.0.13'; assert not any((d.metadata.get('Name') or '').lower()=='aiperf' for d in m.distributions())" && \
    /opt/venvs/agentx113/bin/agentx --help > /dev/null && \
    ${AGENTX_PYTHON} -c "import ais_bench,importlib.metadata as m; assert not any((d.metadata.get('Name') or '').lower()=='agentx-harness' for d in m.distributions())"

ENV AISBENCH_AGENTX_PYTHON=/opt/venvs/agentx113/bin/python

WORKDIR /benchmark
