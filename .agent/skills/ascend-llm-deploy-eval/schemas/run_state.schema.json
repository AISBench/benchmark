{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "service",
    "cases",
    "releases"
  ],
  "properties": {
    "service": {
      "enum": [
        "ABSENT",
        "DEPLOYING",
        "DEPLOYED",
        "READY",
        "TESTING",
        "FAILED",
        "UNKNOWN",
        "RELEASED"
      ]
    },
    "releases": {
      "type": "array"
    },
    "container_id": {
      "type": "string"
    },
    "image_id": {
      "type": "string"
    },
    "smoke_identity": {
      "type": [
        "object",
        "null"
      ]
    },
    "cases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "attempts"
        ],
        "properties": {
          "status": {
            "enum": [
              "NOT_RUN",
              "RUNNING",
              "PASSED",
              "FAILED"
            ]
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "attempt",
                "folder",
                "status"
              ],
              "properties": {
                "attempt": {
                  "type": "integer",
                  "minimum": 1
                },
                "folder": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "RUNNING",
                    "PASSED",
                    "FAILED"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
