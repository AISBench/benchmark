{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "stage",
    "status",
    "message",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "stage": {
      "enum": [
        "plan_run",
        "preflight",
        "deploy",
        "evaluate",
        "finalize"
      ]
    },
    "status": {
      "enum": [
        "BLOCKED",
        "PLANNED",
        "PASSED",
        "FAILED",
        "REVIEW_REQUIRED"
      ]
    },
    "message": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "executor": {
      "type": "object",
      "required": [
        "package",
        "script_sha256"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "script_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
