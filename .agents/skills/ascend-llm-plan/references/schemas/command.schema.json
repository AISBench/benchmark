{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "task_id", "kind", "request_id", "expected_version"],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "kind": {"enum": ["deploy", "eval", "release", "cancel"]},
    "expected_version": {"type": "integer", "minimum": 0},
    "wait_ms": {"type": "integer", "minimum": 0, "maximum": 30000},
    "plan_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "service_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "case_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "scope": {"enum": ["task", "operation"]},
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 64}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "deploy"}}}, "then": {"required": ["plan_ref"]}},
    {"if": {"properties": {"kind": {"const": "eval"}}}, "then": {"required": ["service_id", "case_id"]}},
    {"if": {"properties": {"kind": {"const": "release"}}}, "then": {"required": ["service_id"]}},
    {"if": {"properties": {"kind": {"const": "cancel"}}}, "then": {"required": ["scope"]}},
    {"if": {"properties": {"kind": {"const": "cancel"}, "scope": {"const": "operation"}}, "required": ["scope"]}, "then": {"required": ["operation_id"]}}
  ]
}
