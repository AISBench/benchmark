{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "intent",
    "deployment",
    "policy",
    "execution",
    "unresolved"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "intent": {
      "const": "deploy"
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "topology": {
          "enum": [
            "colocated",
            "pd"
          ]
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "served_name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "served_name"
          ]
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "string",
              "minLength": 1
            },
            "container": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "shm_size": {
                  "type": "string",
                  "minLength": 1
                },
                "privileged": {
                  "type": "boolean"
                },
                "user": {
                  "type": "string",
                  "minLength": 1
                },
                "pid_mode": {
                  "enum": [
                    "host",
                    "private"
                  ]
                },
                "devices": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^/dev/"
                  }
                }
              },
              "required": [
                "shm_size",
                "privileged"
              ]
            }
          },
          "required": [
            "image",
            "container"
          ]
        },
        "instances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "role": {
                "enum": [
                  "mixed",
                  "prefill",
                  "decode",
                  "proxy"
                ]
              },
              "placement": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "node": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                  },
                  "devices": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "required": [
                  "node",
                  "devices"
                ]
              },
              "launch": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "program": {
                    "const": "vllm serve"
                  },
                  "preserve_reference": {
                    "type": "boolean",
                    "default": false
                  },
                  "engine_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "adapter": {
                    "const": "external_pd_proxy"
                  },
                  "args": {
                    "type": "object"
                  },
                  "env": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "bootstrap": {
                    "type": "string"
                  },
                  "kv_transfer_config": {
                    "type": "object",
                    "required": [
                      "kv_connector",
                      "kv_role",
                      "kv_port",
                      "engine_id"
                    ],
                    "additionalProperties": true
                  },
                  "proxy_program_key": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                    "default": "proxy_program",
                    "description": "Proxy only: select the physical program path from bindings.nodes[node].paths."
                  }
                },
                "required": []
              },
              "ports": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 256
                }
              },
              "checks": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "health": {
                    "type": "string",
                    "minLength": 1
                  },
                  "prefix_cache_reset": {
                    "const": "/reset_prefix_cache"
                  },
                  "metrics": {
                    "const": "/metrics"
                  }
                },
                "required": [
                  "health"
                ]
              }
            },
            "required": [
              "id",
              "role",
              "placement",
              "launch",
              "ports",
              "checks"
            ]
          }
        },
        "connections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kv_transfer": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "producer": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                  },
                  "consumer": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                  },
                  "connector": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "producer",
                  "consumer",
                  "connector"
                ]
              }
            },
            "routing": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "proxy": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                  },
                  "prefillers": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                    }
                  },
                  "decoders": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                    }
                  }
                },
                "required": [
                  "proxy",
                  "prefillers",
                  "decoders"
                ]
              }
            }
          },
          "required": []
        },
        "endpoint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instance": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "port": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            }
          },
          "required": [
            "instance",
            "port"
          ]
        }
      },
      "required": [
        "id",
        "topology",
        "model",
        "runtime",
        "instances",
        "connections",
        "endpoint"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "smoke": {
          "const": "default",
          "default": "default"
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 3
        },
        "startup_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "smoke_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "enable_cache_reset_api": {
          "type": "boolean",
          "default": true,
          "description": "Inject VLLM_SERVER_DEV_MODE=1 into model instances, including preserve_reference. False disables injection and retains explicit reference environment. Does not execute cache reset."
        },
        "proxy_start_after_models_healthy": {
          "type": "boolean",
          "default": true
        },
        "dependency_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 120
        }
      },
      "required": [
        "startup_timeout_seconds",
        "smoke_timeout_seconds",
        "dependency_timeout_seconds",
        "proxy_start_after_models_healthy",
        "enable_cache_reset_api",
        "max_retries"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idle_timeout_seconds",
        "on_idle",
        "on_failure"
      ],
      "properties": {
        "idle_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "on_idle": {
          "enum": [
            "keep_service",
            "release_owned"
          ]
        },
        "on_failure": {
          "const": "release_owned"
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "test_binding"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/case"
          }
        },
        "test_binding": {
          "$ref": "#/$defs/id"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "concurrency",
        "input_tokens",
        "output_tokens",
        "steady_state",
        "num_warmups",
        "reset_cache",
        "dataset_id",
        "timeout_seconds"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "formal_requests": {
          "type": "integer",
          "minimum": 1
        },
        "steady_state": {
          "type": "boolean"
        },
        "num_warmups": {
          "type": "integer",
          "minimum": 0
        },
        "reset_cache": {
          "type": "boolean"
        },
        "dataset_id": {
          "$ref": "#/$defs/id"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "request_rate": {
          "type": "number",
          "minimum": 0
        },
        "shared_prefix_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
