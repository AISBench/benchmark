{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "protocol_version",
    "task_id",
    "status",
    "time",
    "next_cursor",
    "has_more",
    "events"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "status": {
      "enum": [
        "EVENTS",
        "RUNNING",
        "WAIT_TIMEOUT",
        "ERROR"
      ]
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "next_cursor": {
      "type": "integer",
      "minimum": 0
    },
    "has_more": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "operation_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "task_version": {
      "type": "integer",
      "minimum": 0
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ERROR"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "WAIT_TIMEOUT"
          }
        }
      },
      "then": {
        "properties": {
          "events": {
            "maxItems": 0
          },
          "has_more": {
            "const": false
          }
        }
      }
    }
  ],
  "$defs": {
    "event": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "task_id",
        "seq",
        "task_version",
        "operation_id",
        "type",
        "time",
        "status",
        "data"
      ],
      "properties": {
        "protocol_version": {
          "const": "1.0"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "task_version": {
          "type": "integer",
          "minimum": 0
        },
        "operation_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "time": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "status": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "data": {
          "type": "object"
        }
      }
    }
  }
}
