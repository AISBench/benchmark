{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "operation_id",
    "service_id",
    "case_id",
    "time",
    "execution_status",
    "evidence_status",
    "performance_validity"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "operation_id": {
      "$ref": "#/$defs/id"
    },
    "service_id": {
      "$ref": "#/$defs/id"
    },
    "case_id": {
      "$ref": "#/$defs/id"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "execution_status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "evidence_status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "INVALID"
      ]
    },
    "performance_validity": {
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "INVALID"
      ]
    },
    "actual_load": {
      "type": "object"
    },
    "reason": {
      "type": "string",
      "maxLength": 1024
    },
    "cleanup_status": {
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "NOT_REQUESTED"
      ]
    },
    "prefix_metric_status": {
      "enum": [
        "VERIFIED",
        "UNVERIFIED"
      ]
    },
    "performance": {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "groups",
        "scope"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "status": {
          "enum": [
            "VERIFIED",
            "UNVERIFIED"
          ]
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "model",
              "dataset",
              "stage",
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "VERIFIED",
                  "UNVERIFIED"
                ]
              },
              "duration_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "requests": {
                "type": "integer",
                "minimum": 1
              },
              "request_throughput": {
                "type": "number",
                "minimum": 0,
                "description": "requests/second"
              }
            }
          }
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "framework_log_status": {
      "enum": [
        "COLLECTED",
        "PENDING"
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    }
  }
}
