{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "testers"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "testers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/tester"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "path": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 4096
    },
    "tester": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "work_root",
        "python",
        "aisbench",
        "model_path",
        "datasets"
      ],
      "properties": {
        "host": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^(?:[A-Za-z0-9_.-]+@)?[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "work_root": {
          "$ref": "#/$defs/path"
        },
        "python": {
          "$ref": "#/$defs/path"
        },
        "aisbench": {
          "$ref": "#/$defs/path"
        },
        "model_path": {
          "$ref": "#/$defs/path"
        },
        "datasets": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/dataset"
          }
        },
        "machine_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "environment": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 8192,
            "pattern": "^[^\\u0000]*$"
          }
        },
        "container": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "image"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "image": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "host_python": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "dataset": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "aisbench_synthetic"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path",
            "input_column",
            "output_column"
          ],
          "properties": {
            "type": {
              "enum": [
                "jsonl",
                "csv"
              ]
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "input_column": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "output_column": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "generation_manifest": {
              "$ref": "#/$defs/path"
            }
          }
        }
      ]
    }
  }
}
